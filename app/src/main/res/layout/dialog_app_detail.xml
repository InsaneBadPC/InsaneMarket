<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/detailVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/market_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/market_muted" />

        <TextView
            android:id="@+id/detailNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/market_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailAssign"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/map_package_title"
            android:visibility="gone"
            app:icon="@android:drawable/ic_menu_add" />
    </LinearLayout>
</ScrollView>
